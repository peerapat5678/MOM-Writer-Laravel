# Normalize line endings so shell scripts always run inside Linux containers.
# Without this, cloning on Windows can rewrite scripts to CRLF and the
# container fails with "no such file or directory" on the shebang line.

* text=auto eol=lf

*.sh            text eol=lf
docker/**       text eol=lf
artisan         text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
