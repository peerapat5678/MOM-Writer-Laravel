APP_NAME="MOM Writer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok

# ---- change this per project; everything else derives from it ----
APP_PROJECT=mom-writer
NGINX_PORT=8080
VITE_PORT=5173
APP_URL=http://localhost:${NGINX_PORT}/${APP_PROJECT}
ASSET_URL=${APP_URL}

UID=1000
GID=1000

APP_LOCALE=th
APP_FALLBACK_LOCALE=th
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- database (fill per project; do NOT commit real secrets) ----
# The app's own DB: meeting minutes (moms) and the address book (mom_contacts).
# SQL Server by default; create an empty database, then run: php artisan migrate
# Trying it on your own machine without SQL Server? Use SQLite instead:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=/var/www/html/database/database.sqlite
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=mom_writer
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# ---- UserData: external MSSQL directory that holds data_log_userv2 ----
USERDATA_HOST=192.168.10.18
USERDATA_PORT=1433
USERDATA_DATABASE=UserData
USERDATA_USERNAME=
USERDATA_PASSWORD=
USERDATA_ENCRYPT=yes
USERDATA_TRUST_SERVER_CERTIFICATE=true

# ---- Backoffice auth (opaque tokens; refresh token = 24h) ----
# Sign-in checks employee codes in UserData.data_log_userv2.
# Without access to that server, set this to the app's own connection
# (sqlite / sqlsrv) and add logins with: php artisan mom:user EMP001
BACKOFFICE_AUTH_CONNECTION=UserData
BACKOFFICE_AUTH_TABLE=data_log_userv2
BACKOFFICE_AUTH_ACTIVE_STATUS=active
BACKOFFICE_ACCESS_TTL=60
BACKOFFICE_REFRESH_TTL=1440

# No Redis / OTP / mail server required by default
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_COOKIE=${APP_PROJECT}_session
SESSION_LIFETIME=120
SESSION_PATH=/${APP_PROJECT}
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Vite (used at build time; derive from APP_PROJECT) ----
VITE_APP_NAME="${APP_NAME}"
VITE_BASE_PATH=/${APP_PROJECT}/
VITE_APP_URL=${APP_URL}
VITE_ASSET_BASE=/${APP_PROJECT}/build/
VITE_ROUTER_BASE=/${APP_PROJECT}/
VITE_API_BASE=/${APP_PROJECT}/api
VITE_PUBLIC_BASE=/${APP_PROJECT}/

# ---- MOM Writer ----
# Google OAuth Client ID (Web application) for "create Gmail draft"; leave empty to hide it
VITE_GOOGLE_CLIENT_ID=
# Name used to sign off documents/emails; empty = the signed-in user's name
VITE_MOM_SENDER_NAME=
# Letters in the PDF header logo (default TG); empty = no logo
VITE_MOM_BRAND=TG
