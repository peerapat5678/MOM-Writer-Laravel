APP_NAME="My App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok

# ---- change this per project; everything else derives from it ----
APP_PROJECT=app
NGINX_PORT=8080
VITE_PORT=5173
APP_URL=http://localhost:${NGINX_PORT}/${APP_PROJECT}
ASSET_URL=${APP_URL}

UID=1000
GID=1000

APP_LOCALE=th
APP_FALLBACK_LOCALE=th
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- database (fill per project; do NOT commit real secrets) ----
# This is the app's own DB (stores backoffice auth/refresh tokens, cache, jobs).
# Maps to the "mysql" connection in config/database.php.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- UserData: external MSSQL directory that holds data_log_userv2 ----
USERDATA_HOST=192.168.10.18
USERDATA_PORT=1433
USERDATA_DATABASE=UserData
USERDATA_USERNAME=
USERDATA_PASSWORD=
USERDATA_ENCRYPT=yes
USERDATA_TRUST_SERVER_CERTIFICATE=true

# ---- Backoffice auth (opaque tokens; refresh token = 24h) ----
BACKOFFICE_AUTH_CONNECTION=UserData
BACKOFFICE_AUTH_TABLE=data_log_userv2
BACKOFFICE_AUTH_ACTIVE_STATUS=active
BACKOFFICE_ACCESS_TTL=60
BACKOFFICE_REFRESH_TTL=1440

# No Redis / OTP / mail server required by default
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_COOKIE=${APP_PROJECT}_session
SESSION_LIFETIME=120
SESSION_PATH=/${APP_PROJECT}
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Vite (used at build time; derive from APP_PROJECT) ----
VITE_APP_NAME="${APP_NAME}"
VITE_BASE_PATH=/${APP_PROJECT}/
VITE_APP_URL=${APP_URL}
VITE_ASSET_BASE=/${APP_PROJECT}/build/
VITE_ROUTER_BASE=/${APP_PROJECT}/
VITE_API_BASE=/${APP_PROJECT}/api
VITE_PUBLIC_BASE=/${APP_PROJECT}/
